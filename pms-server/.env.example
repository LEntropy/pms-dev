# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pms:pms_secret@localhost:5432/pms

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ── JWT (RS256) ───────────────────────────────────────────────────────
# 키 파일이 없으면 앱 시작 시 자동 생성됨
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_AGENT_TOKEN_EXPIRE_DAYS=30

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# ── MinIO (S3 호환 오브젝트 스토리지) ────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=pms_minio
MINIO_SECRET_KEY=minio_secret
MINIO_SECURE=false
MINIO_BUCKET_PATCHES=patches
MINIO_BUCKET_AGENTS=agents
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=3600

# ── Agent ─────────────────────────────────────────────────────────────
AGENT_HEARTBEAT_INTERVAL_SECONDS=300
AGENT_OFFLINE_THRESHOLD_SECONDS=900

# ── CORS ─────────────────────────────────────────────────────────────
# 쉼표로 구분 (JSON 배열 형태)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── SMTP (이메일 알림) ────────────────────────────────────────────────
# 미설정 시 이메일 발송 생략 (로그만 기록)
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=pms-noreply@company.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=pms-noreply@company.com
SMTP_TLS=true

# ── 에이전트 업그레이드 ───────────────────────────────────────────────
# 최신 에이전트 버전 정보 (관리자 업그레이드 푸시 기본값)
LATEST_AGENT_VERSION=0.1.0
AGENT_DOWNLOAD_BASE_URL=https://files.company.com/agents

# ── LDAP / Active Directory ───────────────────────────────────────────
# 미설정(빈 값) 시 LDAP 동기화 비활성화
LDAP_URL=ldap://dc.company.com:389
LDAP_BIND_DN=CN=pms-svc,OU=ServiceAccounts,DC=company,DC=com
LDAP_BIND_PASSWORD=service_account_password
LDAP_BASE_DN=DC=company,DC=com
LDAP_USER_FILTER=(&(objectClass=user)(objectCategory=person)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))

# ── OpenVAS / GVM ─────────────────────────────────────────────────────
# 미설정(빈 값) 시 스캔 비활성화
OPENVAS_URL=https://openvas.company.com
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=openvas_password

# ── App ───────────────────────────────────────────────────────────────
DEBUG=true
APP_NAME=PMS Server
APP_VERSION=0.1.0
